# ==============================================================================
# SNAP APP Environment Variables Template
# Copy this file to `.env.local` and fill in your actual credentials.
# NEVER commit `.env.local` to git or expose secrets to the client.
# ==============================================================================

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION
# 🔗 Get Project URL & API Keys: https://supabase.com/dashboard/project/_/settings/api
# 🔗 Get Supabase Personal Access Token (CLI/Management API): https://supabase.com/dashboard/account/tokens
# ------------------------------------------------------------------------------
# Public Supabase URL (Project URL from Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public Supabase Anon Key (Browser-safe anon public key from Project Settings -> API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-Only Supabase Service Role Key (STRICTLY SERVER-ONLY, Project Settings -> API)
# Required for automated API provisioning, bucket setup & admin operations
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase Personal Access Token (Optional: for direct Supabase CLI automation)
# Generate at: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=your-supabase-access-token

# ------------------------------------------------------------------------------
# GITHUB AUTOMATION CONFIGURATION
# 🔗 Generate Personal Access Token (PAT): https://github.com/settings/tokens
# (Click "Generate new token (classic)" -> select scopes: `repo`, `workflow`)
# ------------------------------------------------------------------------------
GITHUB_TOKEN=your-github-personal-access-token

# ------------------------------------------------------------------------------
# VERCEL DEPLOYMENT CONFIGURATION (Optional: for Vercel CLI/API automation)
# 🔗 Generate Vercel Token: https://vercel.com/account/tokens
# ------------------------------------------------------------------------------
VERCEL_TOKEN=your-vercel-deployment-token

# ------------------------------------------------------------------------------
# ADMIN ACCESS CONFIGURATION (Also required in Vercel environment variables)
# ------------------------------------------------------------------------------
ADMIN_EMAIL=shoaibzaynah@gmail.com
NEXT_PUBLIC_ADMIN_EMAIL=shoaibzaynah@gmail.com

# ------------------------------------------------------------------------------
# APPLICATION BASE URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# CARTO BASEMAPS API KEY (Removes raster watermark on maps)
# 🔗 Get Free Key (5M requests/mo): https://carto.com/basemaps/apikey
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CARTO_API_KEY=your-carto-basemaps-api-key
